{
  "name": "duochat",
  "displayName": "DuoChat",
  "description": "Chat temps réel et chiffré de bout en bout entre développeurs, dans la barre latérale de VS Code. Aucun serveur à installer : créez un salon, envoyez l'invitation. Partagez fichier:ligne en un clic.",
  "version": "0.3.0",
  "publisher": "duochat",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#11131c",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "chat",
    "team",
    "collaboration",
    "realtime",
    "pair programming",
    "messaging",
    "encrypted",
    "nostr"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "duochat",
          "title": "DuoChat",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "duochat": [
        {
          "type": "webview",
          "id": "duochat.chat",
          "name": "Chat",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "duochat.configure",
        "title": "Créer ou rejoindre un salon",
        "category": "DuoChat",
        "icon": "$(gear)"
      },
      {
        "command": "duochat.connect",
        "title": "Se connecter",
        "category": "DuoChat",
        "icon": "$(plug)"
      },
      {
        "command": "duochat.disconnect",
        "title": "Se déconnecter",
        "category": "DuoChat",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "duochat.shareLocation",
        "title": "Partager le fichier et la ligne courantes",
        "category": "DuoChat",
        "icon": "$(link)"
      },
      {
        "command": "duochat.copyInvite",
        "title": "Copier l'invitation du salon",
        "category": "DuoChat",
        "icon": "$(person-add)"
      },
      {
        "command": "duochat.open",
        "title": "Ouvrir le chat",
        "category": "DuoChat",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "duochat.shareLocation",
          "when": "view == duochat.chat && duochat.connected",
          "group": "navigation@1"
        },
        {
          "command": "duochat.connect",
          "when": "view == duochat.chat && !duochat.connected && duochat.configured",
          "group": "navigation@2"
        },
        {
          "command": "duochat.disconnect",
          "when": "view == duochat.chat && duochat.connected",
          "group": "navigation@2"
        },
        {
          "command": "duochat.copyInvite",
          "when": "view == duochat.chat && duochat.configured",
          "group": "navigation@3"
        },
        {
          "command": "duochat.configure",
          "when": "view == duochat.chat",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "duochat.shareLocation",
          "when": "resourceScheme == file",
          "group": "duochat@1"
        }
      ]
    },
    "configuration": {
      "title": "DuoChat",
      "properties": {
        "duochat.serverUrl": {
          "type": "string",
          "default": "",
          "pattern": "^$|^(https?|wss?)://.+",
          "markdownDescription": "Laisser **vide** pour le réseau public chiffré (par défaut, rien à installer). Options avancées : URL de votre projet Supabase (`https://<projet>.supabase.co`) ou de votre relais DuoChat (`wss://…`)."
        },
        "duochat.displayName": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pseudo affiché aux autres participants. Vide = nom d'utilisateur du système."
        },
        "duochat.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Afficher une notification quand un message arrive et que le chat n'est pas visible."
        },
        "duochat.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Se connecter automatiquement au démarrage si un salon est configuré."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@supabase/realtime-js": "^2.118.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "nostr-tools": "^2.25.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
